# ---- Site ----
# Your real address. Must be https:// in production (used for canonical URLs, sitemaps and social cards).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=DramaFlix
CONTACT_EMAIL=contact@yourdomain.com

# ---- Admin login ----
ADMIN_USERNAME=admin
# 12+ characters and not a placeholder, or the production server refuses to start
ADMIN_PASSWORD=use-a-long-random-password
# openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
# openssl rand -hex 16. Protects /api/cron/* (the production stack's cron container uses it)
CRON_SECRET=replace-with-output-of-openssl-rand-hex-16

# ---- Database ----
# Local development (docker compose up -d starts Postgres on port 5434).
# In production docker-compose.prod.yml builds the connection string from the POSTGRES_* values below.
DATABASE_URL=postgresql://drama:drama@localhost:5434/drama

# ---- Production stack only (docker-compose.prod.yml) ----
# Domain Caddy gets the HTTPS certificate for (no https://, no www). www.<domain> redirects to it.
DOMAIN=yourdomain.com
POSTGRES_USER=dramaflix
# openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dramaflix
# Days of nightly database backups to keep in ./backups
BACKUP_KEEP_DAYS=14

# ---- Video ----
# Player ID from Dailymotion Partner HQ (Players > Create). Read at build time.
NEXT_PUBLIC_DAILYMOTION_PLAYER_ID=
# Comma-separated hosts allowed for non-Dailymotion video links (your video server). Empty = any https host.
# Read at build time (it sets the Content Security Policy).
ALLOWED_SOURCE_HOSTS=player.yourvideoserver.com,cdn.yourvideoserver.com
# Optional, comma-separated: only resize cover images from these hosts. Read at build time.
IMAGE_HOSTS=

# ---- SEO ----
# Optional: any random 32-char hex string; enables IndexNow pings to Bing/Yandex on publish
INDEXNOW_KEY=
# From Google Search Console / Bing Webmaster Tools (HTML tag method, content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
